# ============================================================================
# Atelier — variables d'environnement
# Copier en .env pour le développement local.
# ============================================================================

NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# ---- Obligatoire -----------------------------------------------------------
DATABASE_URL=postgresql://user:pass@localhost:5432/atelier
JWT_SECRET=chaine-aleatoire-de-32-caracteres-minimum

# ---- File d'attente --------------------------------------------------------
# Sans Redis, une file en mémoire prend le relais : utilisable en
# développement, déconseillé en production (les travaux en attente sont
# perdus au redémarrage).
REDIS_URL=redis://127.0.0.1:6379

# ---- Stockage --------------------------------------------------------------
# local : disque, pour le développement.
# s3    : Cloudflare R2, AWS S3, Backblaze. Obligatoire en production, le
#         disque de Render étant éphémère.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# S3_ENDPOINT=https://<compte>.r2.cloudflarestorage.com
# S3_BUCKET=atelier
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# S3_PUBLIC_BASE=https://fichiers.mondomaine.tn

# ---- Fournisseurs d'IA -----------------------------------------------------
# Tous facultatifs. Sans clé, le fournisseur de démonstration prend le relais
# et toute la chaîne reste testable.
# BYTEPLUS_API_KEY=
# ANTHROPIC_API_KEY=
# FAL_API_KEY=

# ---- Paiement par carte (Konnect) ------------------------------------------
# Stripe n'accepte pas les marchands tunisiens : Konnect est le rail carte.
# KONNECT_API_KEY=
# KONNECT_WALLET_ID=
KONNECT_BASE_URL=https://api.konnect.network/api/v2

# ---- Règles métier ---------------------------------------------------------
SIGNUP_BONUS_CREDITS=100
HOLD_TTL_SECONDS=900
WORKER_CONCURRENCY=10
RUN_WORKER_IN_PROCESS=true
DEDUP_ENABLED=true
MAX_BATCH_ROWS=500
MAX_UPLOAD_MB=15
